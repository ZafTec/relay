# Local development only. Copy to .env; never commit credentials.
APP_NAME=Relay
APP_VERSION=development
GIT_SHA=unknown
PORT=8000

DATABASE_URL=postgresql://relay_app:relay_dev_only@localhost:5432/relay
REDIS_URL=redis://:relay_dev_only@localhost:6379
# Internal endpoint used for server-side S3/MinIO traffic.
S3_ENDPOINT=
# Client-reachable signing endpoint for the local MinIO instance.
S3_PUBLIC_ENDPOINT=
# Optional; blank defaults to us-east-1.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional; only true is accepted and blank defaults to true.
S3_FORCE_PATH_STYLE=
# Optional; only enabled is accepted and blank defaults to enabled.
S3_BUCKET_VERSIONING=
# Optional; 1-120000 milliseconds, default 30000.
S3_REQUEST_TIMEOUT_MS=

BETTER_AUTH_URL=http://localhost:8000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DATABASE_URL above must authenticate as relay_app for the API process
# (see scripts/dev/postgres-init/001-roles-and-schemas.sql) -- Better Auth
# needs SELECT/INSERT/UPDATE/DELETE on the auth schema at runtime, not DDL
# rights.

# Only packages/database/src/migrator_test.ts reads this. Those tests drop
# and recreate relay.schema_migrations and replay the migration manifest
# against fixture migrations -- genuinely destructive operations that must
# never run against the same database as DATABASE_URL above. Point this at
# the disposable `relay_test` database created by
# scripts/dev/postgres-init/002-test-database.sql, connecting as
# relay_migrator; the tests themselves refuse to run (rather than silently
# operate on the wrong database) unless the database name ends in `_test`.
MIGRATOR_TEST_DATABASE_URL=postgresql://relay_migrator:relay_dev_only@localhost:5432/relay_test

# Artifact quota and lifecycle (API and worker only).
# Required positive per-workspace storage limit in bytes.
ARTIFACT_WORKSPACE_MAX_BYTES=
# Optional; capped by the workspace limit and 5 GiB.
ARTIFACT_MAX_UPLOAD_BYTES=
# Optional bounded lifetimes in seconds.
ARTIFACT_UPLOAD_TTL_SECONDS=
ARTIFACT_DOWNLOAD_TTL_SECONDS=
ARTIFACT_PURGE_DELAY_SECONDS=
ARTIFACT_CLEANUP_LEASE_SECONDS=
# Optional bounded worker maintenance cadence and batch size.
ARTIFACT_MAINTENANCE_INTERVAL_MS=
ARTIFACT_MAINTENANCE_BATCH_SIZE=

# API-only share-token signing keyring.
# Positive version that must exist in SHARE_TOKEN_KEYS.
SHARE_TOKEN_ACTIVE_VERSION=
# JSON object of version:base64/base64url secrets (at least 32 decoded bytes).
SHARE_TOKEN_KEYS=

# Worker-only resource URLs (omit /api/projects/...) and their matching keys.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_OCR_ENDPOINT=
AZURE_OCR_API_KEY=
# Optional model overrides require both ENDPOINT and API_KEY. Supported prefixes:
# AZURE_GPT_IMAGE_2, AZURE_FLUX_2_PRO, AZURE_MISTRAL_OCR.
# Optional bounded provider timeout, response, and decoded output limits.
AZURE_REQUEST_TIMEOUT_MS=
AZURE_MAX_RESPONSE_BYTES=
AZURE_MAX_OUTPUT_BYTES=

# Optional email relay for opt-in run notifications. Leave SMTP_HOST empty to disable.
# For local testing, use your existing SMTP capture server; no email is enabled by default.
SMTP_HOST=
SMTP_PORT=587
# starttls (default), tls (usually port 465), or plain (private relay hosts only).
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Origin used by email links; defaults to BETTER_AUTH_URL.
NOTIFICATIONS_APP_URL=http://localhost:8000
