{
  "$meta": {
    "name": "Relay by ZafTech — design tokens",
    "version": "0.1.0",
    "identity": "Ledger (Direction B)",
    "derivedFrom": "ZafTech Design System (onyx / ivory / spruce, Plus Jakarta Sans + JetBrains Mono)",
    "note": "Hex values are the implementation source of truth. OKLCH values quoted from the parent system are given where a token is a direct descendant."
  },
  "color": {
    "product": {
      "$comment": "Authenticated surfaces: /dashboard, /admin. Deep neutral charcoal with restrained teal accents.",
      "bg": {
        "value": "#0F1010",
        "role": "page background"
      },
      "bg-rail": {
        "value": "#0C0D0D",
        "role": "sidebar / rail"
      },
      "surface": {
        "value": "#171919",
        "role": "raised panel"
      },
      "surface-2": {
        "value": "#232626",
        "role": "hairline divider, avatar tile"
      },
      "border": {
        "value": "#2B2E2E",
        "role": "default 1px border"
      },
      "border-strong": {
        "value": "#484C4C",
        "role": "input + secondary button border"
      },
      "ink": {
        "value": "#EDEEEE",
        "role": "primary text",
        "contrastOnBg": "16.4:1"
      },
      "ink-secondary": {
        "value": "#B7BDBD",
        "role": "body text",
        "contrastOnBg": "10.0:1"
      },
      "ink-muted": {
        "value": "#929B9B",
        "role": "mono labels, metadata",
        "contrastOnBg": "6.7:1"
      },
      "accent": {
        "value": "#63C8BC",
        "oklch": "oklch(75.87% 0.087 178.41)",
        "role": "interactive, current, primary button",
        "contrastOnBg": "9.5:1"
      },
      "accent-hover": {
        "value": "#86D6CD",
        "role": "hover"
      },
      "light": {
        "$comment": "Light-mode variant of the product surface. Applied when the viewer's OS/browser prefers light, or has no preference. Kept distinct from the public paper tone (cooler, white raised panels) so /dashboard stays visually distinct from / in both modes.",
        "bg": {
          "value": "#F3F5F3",
          "role": "page background"
        },
        "bg-rail": {
          "value": "#EAEEEB",
          "role": "sidebar / rail"
        },
        "surface": {
          "value": "#FFFFFF",
          "role": "raised panel"
        },
        "surface-2": {
          "value": "#E1E7E3",
          "role": "hairline divider, avatar tile"
        },
        "border": {
          "value": "#DCE3DF",
          "role": "default 1px border"
        },
        "border-strong": {
          "value": "#C4CDC7",
          "role": "input + secondary button border"
        },
        "ink": {
          "value": "#141A16",
          "role": "primary text",
          "contrastOnBg": "15.6:1"
        },
        "ink-secondary": {
          "value": "#46514B",
          "role": "body text",
          "contrastOnBg": "7.3:1"
        },
        "ink-muted": {
          "value": "#5F6B64",
          "role": "mono labels, metadata",
          "contrastOnBg": "5.0:1"
        },
        "accent": {
          "value": "#1F776E",
          "role": "interactive, current, primary button",
          "contrastOnBg": "4.9:1"
        },
        "accent-hover": {
          "value": "#145B54",
          "role": "hover"
        }
      }
    },
    "public": {
      "$comment": "Marketing + public docs/changelog. Paper. Keeps /  visually distinct from /dashboard.",
      "paper": {
        "value": "#F5F4ED",
        "role": "page background"
      },
      "paper-2": {
        "value": "#EFEDE2",
        "role": "alternating section"
      },
      "border": {
        "value": "#D8D5C8",
        "role": "default 1px border"
      },
      "border-strong": {
        "value": "#C9C7BA",
        "role": "secondary button, chips"
      },
      "ink": {
        "value": "#141A16",
        "role": "headings + body",
        "contrastOnPaper": "15.9:1"
      },
      "ink-secondary": {
        "value": "#46514B",
        "role": "supporting body",
        "contrastOnPaper": "7.4:1"
      },
      "ink-muted": {
        "value": "#5F6B64",
        "role": "mono labels, metadata",
        "contrastOnPaper": "5.1:1"
      },
      "accent": {
        "value": "#1F776E",
        "oklch": "oklch(48.58% 0.069 176.43)",
        "role": "interactive, kickers",
        "contrastOnPaper": "4.9:1"
      },
      "accent-hover": {
        "value": "#145B54",
        "role": "hover"
      },
      "invert": {
        "value": "#141A16",
        "role": "high-emphasis button fill on paper"
      }
    },
    "mark": {
      "slab-1": "#3F4E47",
      "slab-2": "#57685F",
      "slab-3": "#7A8C84",
      "slab-4-dark-surface": "#63C8BC",
      "slab-4-light-surface": "#1F776E",
      "reverse-ramp": [
        "#4C5A52",
        "#6B7C74",
        "#9BA9A1",
        "#63C8BC"
      ]
    },
    "status": {
      "$comment": "Status is never colour-only. Every state carries a text label and a glyph.",
      "queued": {
        "glyph": "□",
        "label": "QUEUED",
        "colorProduct": "#63C8BC"
      },
      "running": {
        "glyph": "▪",
        "label": "RUNNING",
        "colorProduct": "#63C8BC"
      },
      "succeeded": {
        "glyph": "■",
        "label": "SUCCEEDED",
        "colorProduct": "#63C8BC"
      },
      "failed": {
        "glyph": "▲",
        "label": "FAILED",
        "colorProduct": "#F5F4ED",
        "border": "1px solid #F5F4ED, 4px left"
      },
      "archived": {
        "glyph": "―",
        "label": "ARCHIVED",
        "treatment": "dashed border, 60% opacity"
      },
      "at-limit": {
        "glyph": "■ filled bar",
        "label": "AT LIMIT / BLOCKED",
        "colorPublic": "#141A16"
      }
    }
  },
  "typography": {
    "families": {
      "sans": {
        "stack": "\"Plus Jakarta Sans\", \"Segoe UI\", sans-serif",
        "license": "OFL 1.1",
        "weights": [
          400,
          500,
          700
        ]
      },
      "mono": {
        "stack": "\"JetBrains Mono\", ui-monospace, monospace",
        "license": "OFL 1.1",
        "weights": [
          400,
          500,
          700
        ]
      }
    },
    "rules": [
      "Headings: sans 700, letter-spacing -0.03em to -0.04em, line-height 0.98-1.15.",
      "Wordmark: sans 500, letter-spacing 0.01em, sentence case 'Relay' (Ledger spec).",
      "Body: sans 400, 15-19px, line-height 1.55-1.65.",
      "Mono: uppercase, letter-spacing 0.10em-0.14em, 9-13px. Labels, metadata, buttons, kickers, version numbers.",
      "Section kickers keep the parent motif exactly: '// 01 Section name'."
    ],
    "scale": {
      "hero": {
        "size": "clamp(38px, 7cqi, 82px)",
        "weight": 700,
        "tracking": "-0.04em",
        "leading": 0.98
      },
      "h1-page": {
        "size": "26-30px",
        "weight": 700,
        "tracking": "-0.03em"
      },
      "h2-section": {
        "size": "clamp(26px, 3cqi, 40px)",
        "weight": 700,
        "tracking": "-0.035em",
        "leading": 1.08
      },
      "h3-card": {
        "size": "16-17px",
        "weight": 700,
        "tracking": "-0.02em"
      },
      "body-lg": {
        "size": "17-19px",
        "leading": 1.6
      },
      "body": {
        "size": "15px",
        "leading": 1.6
      },
      "mono-label": {
        "size": "10-11px",
        "tracking": "0.14em",
        "case": "upper"
      },
      "mono-data": {
        "size": "12-14px",
        "tracking": "0.02em-0.06em",
        "case": "as stored"
      },
      "code": {
        "size": "13px",
        "leading": 1.7
      }
    }
  },
  "space": {
    "scale": [
      4,
      8,
      10,
      12,
      16,
      20,
      24,
      28,
      32,
      40,
      48,
      56,
      64,
      88,
      104
    ],
    "sectionY": "clamp(40px, 6cqi, 88px)",
    "gutter": "clamp(16px, 4cqi, 40px)",
    "container": "1200px",
    "appGutter": "32px",
    "railWidth": "260px",
    "drawerWidth": "480px"
  },
  "radius": {
    "all": "0",
    "exception": "50% on avatar circles only"
  },
  "border": {
    "hairline": "1px",
    "emphasis": "3px top rule on cards and stage plates",
    "statusBar": "4px left on failure and security items"
  },
  "elevation": {
    "$comment": "Borders do the separation work. Shadow only on true overlays.",
    "flat": "none",
    "overlay": "0 24px 48px rgba(0,0,0,0.40)",
    "scrim": "rgba(14,19,16,0.72)"
  },
  "icon": {
    "grid": 32,
    "stroke": 3,
    "caps": "butt",
    "joins": "miter",
    "rule": "Geometry only: rectangles, orthogonal paths, one diagonal maximum. No rounded caps, no filled illustration.",
    "glyphSet": [
      "■ terminal success",
      "□ pending/draft",
      "▲ failure/warning",
      "― archived",
      "▪ node",
      "▾ menu",
      "→ ← continuation"
    ]
  },
  "motion": {
    "duration": {
      "press": "80ms",
      "hover": "180ms",
      "reveal": "400ms",
      "stage": "220ms per stage"
    },
    "easing": {
      "out-strong": "cubic-bezier(0.16, 1, 0.3, 1)",
      "linear": "linear"
    },
    "patterns": [
      "reveal: opacity 0->1 + translateY 20px->0, 400ms out-strong, 80ms stagger per grid item.",
      "accent bar: card top rule scaleX 0->1 from left, 180ms out-strong.",
      "press: scale 0.97, 80ms.",
      "stage connect: request path draws stage by stage, 220ms each, only on first view of the hero.",
      "job state change: label crossfades 180ms; the glyph swaps instantly."
    ],
    "reducedMotion": "prefers-reduced-motion: reduce disables reveal, path drawing, and press scaling. All labels, glyphs and stages render in their final state immediately."
  },
  "breakpoints": {
    "mobile": "<=640px",
    "tablet": "641-1024px",
    "desktop": ">=1025px",
    "appRailCollapse": "<=900px"
  },
  "a11y": {
    "minContrastText": "4.5:1",
    "minContrastGraphic": "3:1",
    "focusRing": "2px solid #63C8BC (product) / #1F776E (public), 2px offset, never removed",
    "minTouchTarget": "44px",
    "statusRule": "label + glyph, never colour alone"
  }
}
