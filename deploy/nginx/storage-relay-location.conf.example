# Copy inside the existing storage.zaftech.co server in minio.conf.
# MinIO handles CORS. No additional server or include file is needed on the VPS.
location ^~ /relay-artifacts/ {
    access_log off;
    error_log /dev/null;
    add_header Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    proxy_pass http://minio:9000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Referer "";
    proxy_set_header Connection "";
    chunked_transfer_encoding off;
}
