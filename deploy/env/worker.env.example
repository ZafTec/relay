# Copy to /opt/relay/env/worker.env, provision every blank through the host
# secret-management process, and chmod 0600. Use the runtime database role,
# never the migrator, and do not add API auth or share-token credentials.
APP_ENV=production

DATABASE_URL=
REDIS_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=5000

# S3-compatible MinIO storage. The worker uses only the internal data-network
# endpoint; browser-facing S3_PUBLIC_ENDPOINT belongs in api.env only.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=relay-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VERSIONING=enabled
S3_REQUEST_TIMEOUT_MS=30000

# Keep this production artifact policy identical to api.env.
ARTIFACT_WORKSPACE_MAX_BYTES=10737418240
ARTIFACT_MAX_UPLOAD_BYTES=104857600
ARTIFACT_UPLOAD_TTL_SECONDS=900
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_PURGE_DELAY_SECONDS=604800
ARTIFACT_CLEANUP_LEASE_SECONDS=60
ARTIFACT_MAINTENANCE_INTERVAL_MS=30000
ARTIFACT_MAINTENANCE_BATCH_SIZE=100

# Worker-only provider credential. Never copy it into api.env or migrate.env.
AZURE_API_KEY=
