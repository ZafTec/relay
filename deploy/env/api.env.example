# Copy to /opt/relay/env/api.env, provision every blank through the host
# secret-management process, and chmod 0600. Every key in this template is
# mandatory in production; do not add worker-only provider credentials.
APP_ENV=production

DATABASE_URL=
REDIS_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=5000

BETTER_AUTH_URL=https://relay.zaftech.co
BETTER_AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=https://relay.zaftech.co
# Set only the exact, stable Nginx container address on RELAY_EDGE_NETWORK.
# Use a bare address or /32 (IPv4) or /128 (IPv6), never a whole subnet.
AUTH_TRUSTED_PROXY_CIDRS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# S3-compatible MinIO storage. The internal endpoint must be reachable on the
# data network. S3_PUBLIC_ENDPOINT must be the browser-reachable HTTPS S3 API
# origin (not the MinIO Console) with the bucket CORS policy from deploy/minio/.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=relay-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VERSIONING=enabled
S3_REQUEST_TIMEOUT_MS=30000

# Explicit production artifact policy. Review capacity before changing the
# workspace quota; API and worker values must remain identical.
ARTIFACT_WORKSPACE_MAX_BYTES=10737418240
ARTIFACT_MAX_UPLOAD_BYTES=104857600
ARTIFACT_UPLOAD_TTL_SECONDS=900
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_PURGE_DELAY_SECONDS=604800
ARTIFACT_CLEANUP_LEASE_SECONDS=60
ARTIFACT_MAINTENANCE_INTERVAL_MS=30000
ARTIFACT_MAINTENANCE_BATCH_SIZE=100

# API-only keyring. SHARE_TOKEN_KEYS is a JSON object whose positive integer
# keys are versions and whose values are base64/base64url secrets of >=32 bytes.
# Keep retired keys while their links remain valid; advance the active version
# for rotation. Provision the JSON as one line without exposing it in history.
SHARE_TOKEN_ACTIVE_VERSION=1
SHARE_TOKEN_KEYS=
