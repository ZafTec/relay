# Copy to /opt/relay/env/migrate.env, fill through the host secret-management
# process, and chmod 0600. This dedicated URL may use the relay_migrator role;
# do not copy it into api.env or worker.env, and do not add provider, auth,
# share-token, storage, or other undocumented variables to this file.
DATABASE_URL=
DATABASE_POOL_MAX=2
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=600000
