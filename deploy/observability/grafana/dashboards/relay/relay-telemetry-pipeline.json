{
  "annotations": { "list": [] },
  "description": "TEMPLATE ONLY. Reconcile Alloy self-metric names, component labels, queue units, and scrape target before relying on this dashboard.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# Telemetry pipeline template\nPrometheus must scrape Alloy's protected administration/self-metrics endpoint. Health alone does not prove backend export.",
        "mode": "markdown"
      },
      "title": "Scrape and alert contract",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{component_id=\"otelcol.receiver.otlp.relay\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "accepted spans",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_spans_total{component_id=\"otelcol.receiver.otlp.relay\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "refused spans",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{component_id=\"otelcol.receiver.otlp.relay\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "refused metric points",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{component_id=\"otelcol.receiver.otlp.relay\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "refused log records",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Receiver accepted and refused",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_send_failed_spans_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "send spans {{component_id}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_send_failed_metric_points_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "send metrics {{component_id}}",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_send_failed_log_records_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "send logs {{component_id}}",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_enqueue_failed_spans_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "queue drops spans {{component_id}}",
          "range": true,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_enqueue_failed_metric_points_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "queue drops metrics {{component_id}}",
          "range": true,
          "refId": "E"
        },
        {
          "editorMode": "code",
          "expr": "sum by (component_id) (rate(otelcol_exporter_enqueue_failed_log_records_total{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "queue drops logs {{component_id}}",
          "range": true,
          "refId": "F"
        }
      ],
      "title": "Exporter send failures and queue drops",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (component_id) (otelcol_exporter_queue_size{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}) / clamp_min(max by (component_id) (otelcol_exporter_queue_capacity{component_id=~\"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)\"}), 1)",
          "instant": false,
          "legendFormat": "{{component_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Exporter queue saturation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{job=\"alloy\"}",
          "instant": false,
          "legendFormat": "resident memory",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Alloy memory",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["relay", "template", "alloy", "telemetry"],
