      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, http_route, job) (rate(relay_http_server_request_duration_seconds_bucket{job=\"relay/relay-api\",deployment_environment_name=~\"$environment\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{job}} {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Route p95 latency",
      "type": "timeseries"
