      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "avg_over_time(probe_success{job=\"relay-public\",deployment_environment_name=~\"$environment\"}[5m])",
          "instant": true,
          "legendFormat": "availability",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "External availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 3 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(relay_http_server_request_duration_seconds_count{job=\"relay/relay-api\",deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "requests/s",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 3 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(relay_http_server_request_duration_seconds_count{job=\"relay/relay-api\",deployment_environment_name=~\"$environment\",http_response_status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(relay_http_server_request_duration_seconds_count{job=\"relay/relay-api\",deployment_environment_name=~\"$environment\"}[$__rate_interval])), 1e-9)",
          "instant": true,
          "legendFormat": "5xx ratio",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Server error ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 3 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_http_server_request_duration_seconds_bucket{job=\"relay/relay-api\",deployment_environment_name=~\"$environment\"}[$__rate_interval])))",
          "instant": true,
          "legendFormat": "p95",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Request latency p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "relay-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
