# TEMPLATE ONLY. Reconcile paths and export existing dashboards before enabling.
apiVersion: 1

providers:
  - name: Relay observability
    orgId: 1
    folder: Relay
    folderUid: relay-observability
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /var/lib/grafana/dashboards/relay
      foldersFromFilesStructure: false
