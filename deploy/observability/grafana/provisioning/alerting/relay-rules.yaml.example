# TEMPLATE ONLY — ALL RULES ARE PAUSED.
# Export/review existing Grafana alerts first. Reconcile translated metric and
# label names, set ${RELAY_ENVIRONMENT}, replace threshold/window placeholders
# from measured SLOs/baselines, decide Grafana vs Alertmanager ownership, and
# configure contact routing outside this credential-free file. Queries assume
# Prometheus OTLP maps Relay resources to job="relay/relay-api" or
# job="relay/relay-worker". Test one real notification before enabling.
apiVersion: 1

groups:
  - orgId: 1
    name: Relay application template
    folder: Relay
    interval: 1m
    rules:
      - uid: relay-api-unavailable
        title: Relay external API unavailable (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: 'max_over_time(probe_success{job="relay-public",deployment_environment_name="${RELAY_ENVIRONMENT}"}[5m]) == bool 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: Alerting
        execErrState: Error
        for: 2m
        annotations:
          summary: Public Relay probe is failing
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/api-unavailable
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: critical, service: relay }
        isPaused: true

      - uid: relay-worker-heartbeat-missing
        title: Relay worker heartbeat missing (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 900, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: 'sum(increase(relay_worker_heartbeats_total{job="relay/relay-worker",deployment_environment_name="${RELAY_ENVIRONMENT}"}[${RELAY_WORKER_HEARTBEAT_MAX_AGE_SECONDS}s])) == bool 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: Alerting
        execErrState: Error
        for: 5m
        annotations:
          summary: No recent Relay worker heartbeat
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/worker-heartbeat
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: critical, service: relay-worker }
        isPaused: true

      - uid: relay-queue-oldest-age
        title: Relay queue oldest age breach (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 1800, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: 'max(relay_queue_oldest_age_seconds{job="relay/relay-worker",deployment_environment_name="${RELAY_ENVIRONMENT}"}) > bool ${RELAY_QUEUE_OLDEST_AGE_SECONDS}'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: OK
        execErrState: Error
        for: 10m
        annotations:
          summary: Relay queued work is older than the approved threshold
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/queue-age
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: warning, service: relay-worker }
        isPaused: true

  - orgId: 1
    name: Relay telemetry pipeline template
    folder: Relay
    interval: 1m
    rules:
      - uid: relay-alloy-refused
        title: Alloy refused Relay telemetry (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: '((sum(increase(otelcol_receiver_refused_spans_total{component_id="otelcol.receiver.otlp.relay"}[5m])) or vector(0)) + (sum(increase(otelcol_receiver_refused_metric_points_total{component_id="otelcol.receiver.otlp.relay"}[5m])) or vector(0)) + (sum(increase(otelcol_receiver_refused_log_records_total{component_id="otelcol.receiver.otlp.relay"}[5m])) or vector(0))) > bool 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: OK
        execErrState: Error
        for: 2m
        annotations:
          summary: Alloy has refused Relay telemetry
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/alloy-refused
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: warning, service: alloy }
        isPaused: true

      - uid: relay-alloy-export-failure
        title: Alloy export failures or queue overflow (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: >-
                ((sum(increase(otelcol_exporter_send_failed_spans_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))
                + (sum(increase(otelcol_exporter_send_failed_metric_points_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))
                + (sum(increase(otelcol_exporter_send_failed_log_records_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))
                + (sum(increase(otelcol_exporter_enqueue_failed_spans_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))
                + (sum(increase(otelcol_exporter_enqueue_failed_metric_points_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))
                + (sum(increase(otelcol_exporter_enqueue_failed_log_records_total{component_id=~"otelcol.exporter.otlphttp.relay_(prometheus|loki|tempo)"}[5m])) or vector(0))) > bool 0
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: An Alloy backend exporter failed or dropped queued telemetry
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/alloy-export
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: warning, service: alloy }
        isPaused: true

      - uid: relay-telemetry-absent
        title: Relay application telemetry unexpectedly absent (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 1800, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: 'absent_over_time(relay_worker_heartbeats_total{job="relay/relay-worker",deployment_environment_name="${RELAY_ENVIRONMENT}"}[${RELAY_TELEMETRY_ABSENCE_WINDOW}])'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: Expected Relay telemetry is absent
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/telemetry-absence
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: critical, service: relay }
        isPaused: true

      - uid: relay-loki-discarded
        title: Loki discarded Relay log samples (template)
        condition: A
        data:
          - refId: A
            relativeTimeRange: { from: 600, to: 0 }
            datasourceUid: relay-prometheus
            model:
              datasource: { type: prometheus, uid: relay-prometheus }
              editorMode: code
              expr: '(sum(increase(loki_discarded_samples_total[5m])) or vector(0)) > bool 0'
              instant: true
              intervalMs: 1000
              maxDataPoints: 43200
              refId: A
        noDataState: OK
        execErrState: Error
        for: 5m
        annotations:
          summary: Loki is discarding log samples
          runbook_url: ${RELAY_RUNBOOK_BASE_URL}/loki-discarded
        labels: { environment: "${RELAY_ENVIRONMENT}", severity: warning, service: loki }
        isPaused: true
