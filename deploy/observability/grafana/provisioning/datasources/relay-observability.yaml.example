# TEMPLATE ONLY. Export and reconcile live Grafana datasources, URLs, versions,
# access policy, and UIDs before renaming this file for provisioning. No secrets
# belong here. The fixed UIDs are referenced by dashboards and alert skeletons.
apiVersion: 1

prune: false

datasources:
  - name: Relay Prometheus
    uid: relay-prometheus
    type: prometheus
    access: proxy
    url: ${RELAY_PROMETHEUS_GRAFANA_URL}
    editable: false
    jsonData:
      httpMethod: POST
      manageAlerts: false
      prometheusType: Prometheus
      timeInterval: 15s

  - name: Relay Loki
    uid: relay-loki
    type: loki
    access: proxy
    url: ${RELAY_LOKI_GRAFANA_URL}
    editable: false
    jsonData:
      derivedFields:
        - name: TraceID
          datasourceUid: relay-tempo
          matcherRegex: '"trace_id"\s*:\s*"([0-9a-f]{32})"'
          url: '$${__value.raw}'
          urlDisplayLabel: View trace
      maxLines: 1000

  - name: Relay Tempo
    uid: relay-tempo
    type: tempo
    access: proxy
    url: ${RELAY_TEMPO_GRAFANA_URL}
    editable: false
    jsonData:
      nodeGraph:
        enabled: true
      # Keep only if the audited Tempo deployment generates service-graph metrics
      # into this exact Prometheus datasource.
      serviceMap:
        datasourceUid: relay-prometheus
      tracesToLogsV2:
        datasourceUid: relay-loki
        filterBySpanID: false
        filterByTraceID: true
        spanEndTimeShift: 1m
        spanStartTimeShift: -1m
        tags:
          - key: service.name
            value: service_name
