# /opt/relay/.env — chmod 0600. Shared by the backend services, like Convia.
# The static web image does not need runtime environment variables.
APP_ENV=production
PORT=8000
DATABASE_URL=
MIGRATOR_DATABASE_URL=
REDIS_URL=

BETTER_AUTH_URL=https://relay.zaftech.co
AUTH_TRUSTED_ORIGINS=https://relay.zaftech.co
# Trust only the existing Nginx container's stable proxy-net address.
AUTH_TRUSTED_PROXY_CIDRS=172.18.0.2/32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SHARE_TOKEN_ACTIVE_VERSION=1
# Single-quote this JSON value to preserve its double quotes.
SHARE_TOKEN_KEYS=
AZURE_API_KEY=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://relay.zaftech.co
S3_REGION=us-east-1
S3_BUCKET=relay-artifacts
S3_ACCESS_KEY_ID=relay-api
S3_SECRET_ACCESS_KEY=
S3_WORKER_ACCESS_KEY_ID=relay-worker
S3_WORKER_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VERSIONING=enabled
ARTIFACT_WORKSPACE_MAX_BYTES=1073741824
ARTIFACT_MAX_UPLOAD_BYTES=52428800

DEPLOYMENT_ENVIRONMENT_NAME=production
OTEL_DENO=true
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_PROPAGATORS=tracecontext
OTEL_DENO_CONSOLE=capture
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_TRACES_SAMPLER=always_on
