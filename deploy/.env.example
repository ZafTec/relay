# Copy to /opt/relay/.env and chmod 0600. Compose maps each service's settings
# explicitly; never add env_file: .env to a service or print compose config.
# Select both immutable image digests from one verified release manifest.
RELEASE_VERSION=
RELEASE_TAG=
RELEASE_GIT_SHA=
DOCKERHUB_NAMESPACE=zaftec
DOCKERHUB_BACKEND_REPOSITORY=relay-backend
DOCKERHUB_WEB_REPOSITORY=relay-web
BACKEND_DIGEST=
WEB_DIGEST=

RELAY_PUBLIC_URL=https://relay.zaftech.co
RELAY_PROXY_NETWORK=proxy-net
RELAY_DATABASE_NETWORK=postgresql-db-n8n
NGINX_COMPOSE_FILE=/opt/nginx/docker-compose.yml
NGINX_SERVICE=nginx
# Only the exact stable Nginx address, never the proxy-net subnet.
AUTH_TRUSTED_PROXY_CIDRS=172.18.0.2/32

# Runtime uses relay_app; one-shot migrations use relay_migrator.
DATABASE_URL=
MIGRATOR_DATABASE_URL=
REDIS_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_MS=5000

BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SHARE_TOKEN_ACTIVE_VERSION=1
# Single-quote the JSON so Compose preserves the double quotes and literal key.
SHARE_TOKEN_KEYS=
AZURE_API_KEY=

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://relay.zaftech.co
S3_REGION=us-east-1
S3_BUCKET=relay-artifacts
S3_API_ACCESS_KEY_ID=
S3_API_SECRET_ACCESS_KEY=
S3_WORKER_ACCESS_KEY_ID=
S3_WORKER_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT_MS=30000
# Initial limits fit the existing storage proxy's 64 MiB request limit.
ARTIFACT_WORKSPACE_MAX_BYTES=1073741824
ARTIFACT_MAX_UPLOAD_BYTES=52428800
ARTIFACT_UPLOAD_TTL_SECONDS=900
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
ARTIFACT_PURGE_DELAY_SECONDS=604800
ARTIFACT_CLEANUP_LEASE_SECONDS=60
ARTIFACT_MAINTENANCE_INTERVAL_MS=30000
ARTIFACT_MAINTENANCE_BATCH_SIZE=100

DEPLOYMENT_ENVIRONMENT_NAME=production
OTEL_DENO=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_TRACES_SAMPLER=always_on
BACKUP_VERIFIED_AT_FILE=/opt/relay/backup/last-verified-at
BACKUP_MAX_AGE_SECONDS=86400
MIN_FREE_DISK_MB=4096
