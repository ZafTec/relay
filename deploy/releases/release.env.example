# Copy to releases/vMAJOR.MINOR.PATCH.env and replace every blank value.
# This file selects a release pair and contains no application or registry
# credentials. Keep RELEASE_VERSION, RELEASE_TAG, RELEASE_GIT_SHA, and both
# digests exactly aligned with release-manifest.json.
RELEASE_VERSION=0.1.0
RELEASE_TAG=v0.1.0
RELEASE_GIT_SHA=
DOCKERHUB_NAMESPACE=zaftec
DOCKERHUB_BACKEND_REPOSITORY=relay-backend
DOCKERHUB_WEB_REPOSITORY=relay-web
BACKEND_DIGEST=
WEB_DIGEST=

# Optional release selector only. Operational settings and secrets stay in
# /opt/relay/.env; the deploy/rollback scripts load it before this file.
