# Copy to releases/vMAJOR.MINOR.PATCH.env and replace every blank value.
# This file selects a release pair and contains no application or registry
# credentials. Keep RELEASE_VERSION, RELEASE_TAG, RELEASE_GIT_SHA, and both
# digests exactly aligned with release-manifest.json.
RELEASE_VERSION=0.1.0
RELEASE_TAG=v0.1.0
RELEASE_GIT_SHA=
DOCKERHUB_NAMESPACE=zaftec
DOCKERHUB_BACKEND_REPOSITORY=relay-backend
DOCKERHUB_WEB_REPOSITORY=relay-web
BACKEND_DIGEST=
WEB_DIGEST=

# Absolute paths avoid ambiguity when scripts run outside /opt/relay.
API_ENV_FILE=/opt/relay/env/api.env
WORKER_ENV_FILE=/opt/relay/env/worker.env
MIGRATE_ENV_FILE=/opt/relay/env/migrate.env
NGINX_COMPOSE_FILE=/opt/nginx/docker-compose.yml
NGINX_SERVICE=nginx
RELAY_PUBLIC_URL=https://relay.zaftech.co

# Existing, independently managed networks. Preflight only inspects them.
RELAY_EDGE_NETWORK=relay-edge
RELAY_DATA_NETWORK=relay-data
RELAY_TELEMETRY_NETWORK=relay-telemetry

DEPLOYMENT_ENVIRONMENT_NAME=production
OTEL_DENO=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_TRACES_SAMPLER=always_on

# The backup system updates this marker with one RFC 3339 UTC timestamp after
# restore verification. Release scripts only read it.
BACKUP_VERIFIED_AT_FILE=/opt/relay/backup/last-verified-at
BACKUP_MAX_AGE_SECONDS=86400
MIN_FREE_DISK_MB=4096
