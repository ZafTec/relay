{
  "license": "MIT",
  "workspace": [
    "./apps/api",
    "./apps/worker",
    "./packages/application",
    "./packages/artifacts",
    "./packages/audit",
    "./packages/auth",
    "./packages/capacity",
    "./packages/catalog",
    "./packages/changelog",
    "./packages/config",
    "./packages/contracts",
    "./packages/database",
    "./packages/metering",
    "./packages/mcp",
    "./packages/observability",
    "./packages/providers",
    "./packages/queue",
    "./packages/scheduler",
    "./packages/storage",
    "./packages/notifications"
  ],
  "tasks": {
    "dev:api": "deno run --env-file=.env --allow-env --allow-net --allow-read=packages/notifications/src --watch src/main.ts api",
    "dev:worker": "deno run --env-file=.env --allow-env --allow-net --allow-read=packages/notifications/src --watch src/main.ts worker",
    "start:api": "deno run --env-file=.env --allow-env --allow-net --allow-read=packages/notifications/src src/main.ts api",
    "start:worker": "deno run --env-file=.env --allow-env --allow-net --allow-read=packages/notifications/src src/main.ts worker",
    "migrate:up": "deno run --env-file=.env --allow-env --allow-net src/main.ts migrate up",
    "migrate:status": "deno run --env-file=.env --allow-env --allow-net src/main.ts migrate status",
    "admin:bootstrap-superadmin": "deno run --allow-env --allow-net src/main.ts admin bootstrap-superadmin",
    "compile": "deno compile --allow-env --allow-net --include packages/notifications/src/smtp-worker.ts --output dist/relay src/main.ts",
    "test": "deno test --allow-env --allow-net --allow-read apps/api apps/worker packages src",
    "test:coverage": "deno test --allow-env --allow-net --allow-read --coverage=coverage/backend --clean --coverage-threshold=55 apps/api apps/worker packages scripts/dependencies scripts/release src",
    "check": "deno fmt --check apps packages scripts src && deno lint apps packages scripts src && deno check src/main.ts scripts/dev/check-live.ts scripts/ci/api-container-smoke.ts scripts/ci/web-container-smoke.ts && deno task test:coverage",
    "check:live": "deno run --allow-env --allow-run --allow-read scripts/dev/check-live.ts",
    "check:containers": "sh scripts/ci/check-containers.sh",
    "fmt": "deno fmt apps packages scripts src",
    "lint": "deno lint apps packages scripts src"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.asynciterable"
    ]
  },
  "lock": {
    "frozen": true
  },
  "imports": {
    "@better-auth/mcp": "npm:@better-auth/mcp@1.7.2",
    "@hono/hono": "jsr:@hono/hono@^4.13.2",
    "@modelcontextprotocol/client": "npm:@modelcontextprotocol/client@2.0.0",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "better-auth": "npm:better-auth@1.7.2",
    "better-auth/api": "npm:better-auth@1.7.2/api",
    "better-auth/oauth2": "npm:better-auth@1.7.2/oauth2",
    "better-auth/plugins": "npm:better-auth@1.7.2/plugins",
    "better-auth/plugins/jwt": "npm:better-auth@1.7.2/plugins/jwt",
    "bullmq": "npm:bullmq@6.1.2",
    "ioredis": "npm:ioredis@5.11.1",
    "kysely": "npm:kysely@^0.29.5",
    "pg": "npm:pg@^8.23.0",
    "zod/v4": "npm:zod@4.4.3/v4",
    "@denomailer": "https://deno.land/x/denomailer@1.6.0/mod.ts"
  }
}
